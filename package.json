{
  "name": "meridian-token-contract-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Reproducible BNB Smart Chain token compile, test, deploy, and verification kit.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeridianProtocol-Official/meridian-contracts.git"
  },
  "scripts": {
    "compile": "hardhat compile --config hardhat.config.cjs",
    "test": "hardhat test --config hardhat.config.cjs",
    "test:coverage": "hardhat coverage --config hardhat.config.cjs",
    "preflight:testnet": "hardhat run scripts/preflight.cjs --config hardhat.config.cjs --network bscTestnet",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --config hardhat.config.cjs --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.cjs --config hardhat.config.cjs --network bscMainnet",
    "verify:testnet": "hardhat run scripts/verify.cjs --config hardhat.config.cjs --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify.cjs --config hardhat.config.cjs --network bscMainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "dotenv": "16.6.1",
    "ethers": "^6.17.0",
    "hardhat": "2.29.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "keywords": [
    "blockchain",
    "bsc",
    "ethereum",
    "erc20",
    "bep20",
    "smart-contracts",
    "solidity",
    "staking",
    "vesting",
    "meridian"
  ],
  "author": "Meridian Protocol",
  "license": "MIT"
}
