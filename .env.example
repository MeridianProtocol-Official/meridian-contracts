# Copy this file to .env and fill in your own values locally.
# NEVER commit .env, a private key, a seed phrase or an API secret.

# --- Wallet (used by deploy / fund / release scripts) -----------------------
DEPLOYER_PRIVATE_KEY=your_private_key_here
# Optional per-network overrides (take priority over DEPLOYER_PRIVATE_KEY):
# BSC_TESTNET_DEPLOYER_PRIVATE_KEY=your_testnet_private_key_here
# BSC_MAINNET_DEPLOYER_PRIVATE_KEY=your_mainnet_private_key_here

# --- RPC endpoints -----------------------------------------------------------
BSC_TESTNET_RPC_URL=your_bsc_testnet_rpc_url_here
BSC_MAINNET_RPC_URL=your_bsc_mainnet_rpc_url_here

# --- Contract verification (Etherscan V2 key works for BscScan, chain 56 / 97)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# BSCSCAN_API_KEY= (legacy name, still read if ETHERSCAN_API_KEY is empty)

# --- Token scripts (scripts/token/*) -----------------------------------------
INITIAL_HOLDER=0x_wallet_that_receives_the_full_supply
# Optional, defaults shown in the scripts:
# TOKEN_NAME=
# TOKEN_SYMBOL=
# TOKEN_SUPPLY=
# TOKEN_DECIMALS=

# --- Staking scripts (scripts/staking/*) -------------------------------------
STAKING_TOKEN_ADDRESS=0x_mrdn_token_address
INITIAL_OWNER=0x_staking_owner_address

# --- Vesting scripts (scripts/vesting/*) -------------------------------------
MAINNET_VESTING_ADDRESS=
MAINNET_START_TIMESTAMP=
REHEARSAL_TOKEN_ADDRESS=
TESTNET_VESTING_ADDRESS=
TESTNET_START_TIMESTAMP=

# --- Treasury timelock scripts (scripts/treasury/*) --------------------------
# Optional: only needed to preflight against a different token / owner / delay.
# TREASURY_TOKEN_ADDRESS=
# TREASURY_OWNER_ADDRESS=
# TREASURY_MIN_DELAY_SECONDS=
